# =======================================================
# AlgoBuddy — AI Provider Configuration (₹0 Inference Budget)
# =======================================================
# Note: These environment variables are kept STRICTLY server-side
# in the backend API proxy layer (/api/gemma) and are NEVER exposed to the frontend bundle.
# No VITE_ prefix is used, preventing any client-side secret exposure.

# Primary AI Provider Selection:
# 'groq' (Recommended: official free tier, ₹0 budget, OpenAI GPT OSS 20B)
# 'huggingface' (Google Gemma 3 12B Instruct via HF router)
# 'openrouter' | 'ollama' | 'custom'
AI_PROVIDER=groq

# =======================================================
# Groq Cloud Hosted Inference (Official Free Tier, ₹0 Budget)
# =======================================================
# Get a free API key at: https://console.groq.com/keys (no credit card required)
# Free Tier Rate Limits (openai/gpt-oss-20b): 30 RPM, 1,000 RPD, 8,000 TPM
GROQ_API_KEY=

# Supported Groq Models (verified free tier):
# - 'openai/gpt-oss-20b' (Recommended default: 131k context, high reasoning for DSA)
# - 'openai/gpt-oss-120b' (120B parameter model, 131k context, deep reasoning)
GROQ_MODEL=openai/gpt-oss-20b

# Groq OpenAI-Compatible Base URL:
GROQ_ENDPOINT=https://api.groq.com/openai/v1

# =======================================================
# Hugging Face / Google Gemma Configuration (Alternative)
# =======================================================
# Set GEMMA_PROVIDER if AI_PROVIDER is not set or when using Gemma specifically
GEMMA_PROVIDER=huggingface

# Hosted open-weight model:
GEMMA_MODEL=google/gemma-3-12b-it
GEMMA_ENDPOINT=https://router.huggingface.co/v1

# Hugging Face User Access Token (Free tier available at https://huggingface.co/settings/tokens)
HF_TOKEN=
HUGGINGFACE_API_KEY=

# Optional Alternative: OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional Local Ollama (Note: 9B+ local models on Apple Silicon may cause high RAM pressure):
OLLAMA_HOST=http://localhost:11434

# =======================================================
# Production Security & Deployment Configuration
# =======================================================
# Allowed CORS origins (comma-separated, e.g. https://algobuddy.vercel.app,http://localhost:5173)
# Leave unset or empty to allow default origin reflection
ALLOWED_ORIGINS=

# In-Memory Rate Limiting (per container instance):
# Maximum requests per client IP within window (default: 60)
RATE_LIMIT_MAX=60

# Rate limit sliding window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
